rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================================================
    // GLOBAL HARDENED PRIMITIVES
    // ==================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.phone_number != null
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && request.auth.token.email == 'thecontinental.dhpc@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isNotificationRecipient() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'thecontinental.dhpc@gmail.com';
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ==================================================
    // ENTITY VALIDATION HELPERS
    // ==================================================
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'lastLoginAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'lastLoginAt', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role is string && (
          data.role == 'reader' ||
          (data.role == 'super_admin' && isAdmin())
        )
        && data.lastLoginAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phoneNumber', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && (
          ('email' in data && data.email is string && data.email.size() >= 3 && data.email.size() <= 180) ||
          ('phoneNumber' in data && data.phoneNumber is string && data.phoneNumber.size() >= 6 && data.phoneNumber.size() <= 32)
        )
        && (!('email' in data) || (data.email is string && data.email.size() >= 3 && data.email.size() <= 180))
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() >= 6 && data.phoneNumber.size() <= 32))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedArticle(data, userId, articleId) {
      return data.keys().hasAll([
          'id', 'userId', 'articleId', 'slug', 'title', 'summary',
          'categoryName', 'categorySlug', 'authorName', 'publishedAt', 'savedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'articleId', 'slug', 'title', 'summary',
          'categoryName', 'categorySlug', 'authorName', 'featuredImageUrl', 'publishedAt', 'savedAt'
        ])
        && isValidId(data.id)
        && data.id == articleId
        && isValidId(data.userId)
        && data.userId == userId
        && isValidId(data.articleId)
        && data.articleId == articleId
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 160
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.summary is string && data.summary.size() <= 1000
        && data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 80
        && data.categorySlug is string && data.categorySlug.size() >= 1 && data.categorySlug.size() <= 80
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120
        && (!('featuredImageUrl' in data) || (data.featuredImageUrl is string && data.featuredImageUrl.size() <= 500))
        && data.publishedAt is string && data.publishedAt.size() <= 64
        && data.savedAt is timestamp;
    }

    function isValidWriterSubmission(data, submissionId) {
      return data.keys().hasAll([
          'id', 'submissionCode', 'authorUid', 'authorName', 'authorEmail',
          'title', 'categoryId', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'submissionCode', 'authorUid', 'authorName', 'authorEmail',
          'title', 'categoryId', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == submissionId
        && data.submissionCode is string && data.submissionCode.size() >= 3 && data.submissionCode.size() <= 40
        && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 120
        && data.authorEmail is string && data.authorEmail.size() >= 3 && data.authorEmail.size() <= 180
        && data.title is string && data.title.size() >= 6 && data.title.size() <= 220
        && data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 128
        && data.status in ['Submitted', 'Under Review', 'Revision Requested', 'Approved', 'Rejected', 'Published']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminNotification(data, notificationId) {
      return data.keys().hasAll([
          'id', 'eventType', 'recipientEmail', 'actorUid', 'actorEmail',
          'actorName', 'subject', 'message', 'isRead', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'eventType', 'recipientEmail', 'actorUid', 'actorEmail',
          'actorName', 'subject', 'message', 'isRead', 'createdAt'
        ])
        && isValidId(data.id)
        && data.id == notificationId
        && data.eventType in ['user_login', 'user_registered', 'newsletter_subscribe', 'submission_received', 'contact_message']
        && data.recipientEmail == 'thecontinental.dhpc@gmail.com'
        && isValidId(data.actorUid)
        && data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 180
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 220
        && data.message is string && data.message.size() >= 3 && data.message.size() <= 1000
        && data.isRead is bool
        && data.createdAt is timestamp;
    }

    function isValidNewsletterSubscriber(data, subscriberId) {
      return data.keys().hasAll([
          'id', 'email', 'status', 'consentGiven', 'source', 'subscribedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'email', 'status', 'consentGiven', 'source', 'subscribedAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == subscriberId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 180
        && data.status in ['active', 'unsubscribed']
        && data.consentGiven is bool
        && data.source is string && data.source.size() >= 1 && data.source.size() <= 64
        && data.subscribedAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ==================================================
    // COLLECTION RULES
    // ==================================================
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().lastLoginAt == request.time;
      allow update: if isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'lastLoginAt', 'updatedAt'])
          )
        );
      allow delete: if false;

      // Split Collection PII (Email isolation)
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && docId == 'info' && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phoneNumber', 'updatedAt']);
        allow delete: if false;
      }

      // User Reading List (Saved Article References)
      match /saved_articles/{articleId} {
        allow get: if isValidId(userId) && isValidId(articleId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(userId)
          && isValidId(articleId)
          && isOwner(userId)
          && isValidSavedArticle(incoming(), userId, articleId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().savedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(articleId)
          && isOwner(userId)
          && isValidSavedArticle(incoming(), userId, articleId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().articleId == existing().articleId
          && incoming().savedAt == existing().savedAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'summary', 'slug']);
        allow delete: if isValidId(userId) && isValidId(articleId) && (isOwner(userId) || isAdmin());
      }
    }

    match /submissions/{submissionId} {
      allow get: if isValidId(submissionId)
        && isVerifiedUser()
        && (existing().authorUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser()
        && (resource.data.authorUid == request.auth.uid || isAdmin());
      allow create: if isValidId(submissionId)
        && isVerifiedUser()
        && isValidWriterSubmission(incoming(), submissionId)
        && incoming().authorUid == request.auth.uid
        && incoming().status == 'Submitted'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(submissionId)
        && isAdmin()
        && isValidWriterSubmission(incoming(), submissionId)
        && incoming().id == existing().id
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidId(submissionId) && isAdmin();
    }

    match /admin_notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (isAdmin() || isNotificationRecipient());
      allow list: if isAdmin() || isNotificationRecipient();
      allow create: if isValidId(notificationId)
        && isVerifiedUser()
        && isValidAdminNotification(incoming(), notificationId)
        && incoming().actorUid == request.auth.uid
        && incoming().isRead == false
        && incoming().createdAt == request.time;
      allow update: if isValidId(notificationId)
        && (isAdmin() || isNotificationRecipient())
        && isValidAdminNotification(incoming(), notificationId)
        && incoming().id == existing().id
        && incoming().actorUid == existing().actorUid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isValidId(notificationId) && isAdmin();
    }

    match /newsletter_subscribers/{subscriberId} {
      allow get: if isValidId(subscriberId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(subscriberId)
        && isAdmin()
        && isValidNewsletterSubscriber(incoming(), subscriberId)
        && incoming().subscribedAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(subscriberId)
        && isAdmin()
        && isValidNewsletterSubscriber(incoming(), subscriberId)
        && incoming().id == existing().id
        && incoming().subscribedAt == existing().subscribedAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'consentGiven', 'updatedAt']);
      allow delete: if isValidId(subscriberId) && isAdmin();
    }
  }
}
