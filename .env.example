# THE CONTINENTAL — Environment Configuration
# Copy to .env and configure for your hosting environment.

PORT=3000
NODE_ENV=development
APP_URL="https://thecontinental.dhpc.in"

# Session signing secret (set a 64-char random hex string in production)
SESSION_SECRET="replace-with-strong-random-secret"

# Optional Supabase / PostgreSQL configuration (for external Postgres deployments)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Gemini API Key (injected automatically by AI Studio if used)
GEMINI_API_KEY=""

# Notification Inbox Delivery (all alerts go to thecontinental.dhpc@gmail.com)
NOTIFICATION_RECIPIENT_EMAIL="thecontinental.dhpc@gmail.com"
NEXT_PUBLIC_WEB3FORMS_KEY=""
GMAIL_USER="thecontinental.dhpc@gmail.com"
GMAIL_APP_PASSWORD=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="THE CONTINENTAL <onboarding@resend.dev>"
